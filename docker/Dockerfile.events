ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-venv libgl1 libglib2.0-0 \
    ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-nav-msgs ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/events-venv
ENV PATH=/opt/events-venv/bin:$PATH
RUN pip install --no-cache-dir numpy==1.26.4 opencv-python==4.10.0.84
RUN pip install --no-cache-dir torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cu121
RUN pip install --no-cache-dir ultralytics==8.3.40 eclipse-zenoh==1.10.1
WORKDIR /app
COPY detector/ros_event_detector.py .
COPY detector/events ./events
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENTRYPOINT ["/ros_entrypoint.sh", "python", "ros_event_detector.py"]
